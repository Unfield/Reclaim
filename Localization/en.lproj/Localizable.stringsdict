<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld items</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@items@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld item</string>
			<key>other</key>
			<string>%lld items</string>
		</dict>
	</dict>
	<key>%lld files</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@files@</string>
		<key>files</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld file</string>
			<key>other</key>
			<string>%lld files</string>
		</dict>
	</dict>
	<key>%lld packages</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@packages@</string>
		<key>packages</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld package</string>
			<key>other</key>
			<string>%lld packages</string>
		</dict>
	</dict>
	<key>%lld apps · %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@apps@ · %2$@</string>
		<key>apps</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$lld app</string>
			<key>other</key>
			<string>%1$lld apps</string>
		</dict>
	</dict>
	<key>%lld items · %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@items@ · %2$@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$lld item</string>
			<key>other</key>
			<string>%1$lld items</string>
		</dict>
	</dict>
	<key>%lld files · %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@files@ · %2$@</string>
		<key>files</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$lld file</string>
			<key>other</key>
			<string>%1$lld files</string>
		</dict>
	</dict>
	<key>%lld models · %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@models@ · %2$@</string>
		<key>models</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$lld model</string>
			<key>other</key>
			<string>%1$lld models</string>
		</dict>
	</dict>
	<key>%@ · %lld items</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$@ · %2$#@items@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%2$lld item</string>
			<key>other</key>
			<string>%2$lld items</string>
		</dict>
	</dict>
	<key>%lld items couldn't be put back</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@items@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld item couldn't be put back</string>
			<key>other</key>
			<string>%lld items couldn't be put back</string>
		</dict>
	</dict>
	<key>%lld items couldn't be read. Grant Full Disk Access for complete results.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@items@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld item couldn't be read. Grant Full Disk Access for complete results.</string>
			<key>other</key>
			<string>%lld items couldn't be read. Grant Full Disk Access for complete results.</string>
		</dict>
	</dict>
	<key>%lld items couldn't be removed:</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@items@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld item couldn't be removed:</string>
			<key>other</key>
			<string>%lld items couldn't be removed:</string>
		</dict>
	</dict>
	<key>%lld items will be removed.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@items@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld item will be removed.</string>
			<key>other</key>
			<string>%lld items will be removed.</string>
		</dict>
	</dict>
	<key>%lld Ollama models couldn't be read, so Reclaim can't tell which files are shared. Remove it with `ollama rm` instead.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@models@</string>
		<key>models</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Ollama model couldn't be read, so Reclaim can't tell which files are shared. Remove it with `ollama rm` instead.</string>
			<key>other</key>
			<string>%lld Ollama models couldn't be read, so Reclaim can't tell which files are shared. Remove them with `ollama rm` instead.</string>
		</dict>
	</dict>
	<key>Measuring %lld items…</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@items@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Measuring %lld item…</string>
			<key>other</key>
			<string>Measuring %lld items…</string>
		</dict>
	</dict>
	<key>Every %lld minutes</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@minutes@</string>
		<key>minutes</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Every minute</string>
			<key>other</key>
			<string>Every %lld minutes</string>
		</dict>
	</dict>
</dict>
</plist>
