<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld items</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@items@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Objekt</string>
			<key>other</key>
			<string>%lld Objekte</string>
		</dict>
	</dict>
	<key>%lld files</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@files@</string>
		<key>files</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Datei</string>
			<key>other</key>
			<string>%lld Dateien</string>
		</dict>
	</dict>
	<key>%lld packages</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@packages@</string>
		<key>packages</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Paket</string>
			<key>other</key>
			<string>%lld Pakete</string>
		</dict>
	</dict>
	<key>%lld apps · %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@apps@ · %2$@</string>
		<key>apps</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$lld App</string>
			<key>other</key>
			<string>%1$lld Apps</string>
		</dict>
	</dict>
	<key>%lld items · %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@items@ · %2$@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$lld Objekt</string>
			<key>other</key>
			<string>%1$lld Objekte</string>
		</dict>
	</dict>
	<key>%lld files · %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@files@ · %2$@</string>
		<key>files</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$lld Datei</string>
			<key>other</key>
			<string>%1$lld Dateien</string>
		</dict>
	</dict>
	<key>%lld models · %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@models@ · %2$@</string>
		<key>models</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$lld Modell</string>
			<key>other</key>
			<string>%1$lld Modelle</string>
		</dict>
	</dict>
	<key>%@ · %lld items</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$@ · %2$#@items@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%2$lld Objekt</string>
			<key>other</key>
			<string>%2$lld Objekte</string>
		</dict>
	</dict>
	<key>%lld items couldn't be put back</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@items@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Objekt konnte nicht zurückgelegt werden</string>
			<key>other</key>
			<string>%lld Objekte konnten nicht zurückgelegt werden</string>
		</dict>
	</dict>
	<key>%lld items couldn't be read. Grant Full Disk Access for complete results.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@items@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Objekt konnte nicht gelesen werden. Erteile Festplattenvollzugriff für vollständige Ergebnisse.</string>
			<key>other</key>
			<string>%lld Objekte konnten nicht gelesen werden. Erteile Festplattenvollzugriff für vollständige Ergebnisse.</string>
		</dict>
	</dict>
	<key>%lld items couldn't be removed:</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@items@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Objekt konnte nicht entfernt werden:</string>
			<key>other</key>
			<string>%lld Objekte konnten nicht entfernt werden:</string>
		</dict>
	</dict>
	<key>%lld items will be removed.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@items@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Objekt wird entfernt.</string>
			<key>other</key>
			<string>%lld Objekte werden entfernt.</string>
		</dict>
	</dict>
	<key>%lld Ollama models couldn't be read, so Reclaim can't tell which files are shared. Remove it with `ollama rm` instead.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@models@</string>
		<key>models</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Ollama-Modell konnte nicht gelesen werden, daher kann Reclaim nicht feststellen, welche Dateien geteilt werden. Entferne es stattdessen mit `ollama rm`.</string>
			<key>other</key>
			<string>%lld Ollama-Modelle konnten nicht gelesen werden, daher kann Reclaim nicht feststellen, welche Dateien geteilt werden. Entferne sie stattdessen mit `ollama rm`.</string>
		</dict>
	</dict>
	<key>Measuring %lld items…</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@items@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Objekt wird gemessen …</string>
			<key>other</key>
			<string>%lld Objekte werden gemessen …</string>
		</dict>
	</dict>
	<key>Every %lld minutes</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@minutes@</string>
		<key>minutes</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Jede Minute</string>
			<key>other</key>
			<string>Alle %lld Minuten</string>
		</dict>
	</dict>
</dict>
</plist>
